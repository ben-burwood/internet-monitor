---
// A recreated Internet Monitor dashboard rendered from the app's design tokens.
// Pure HTML + inline SVG, theme-aware — used as the hero product visual.

const stats = [
  { label: 'Download', value: '486.2', unit: 'Mbps', accent: 'series-1' },
  { label: 'Upload', value: '41.7', unit: 'Mbps', accent: 'series-2' },
  { label: 'Ping', value: '8.4', unit: 'ms', accent: 'ink' },
  { label: 'Jitter', value: '1.2', unit: 'ms', accent: 'ink' },
];

const ranges = ['24h', '7d', '30d', 'All'];
---

<div
  class="mx-auto max-w-4xl overflow-hidden rounded-xl border border-border bg-card shadow-2xl shadow-black/10 ring-1 ring-black/5"
>
  <!-- Window chrome -->
  <div class="flex items-center gap-2 border-b border-border bg-surface-2 px-4 py-3">
    <div class="flex gap-1.5">
      <span class="h-3 w-3 rounded-full bg-[#ec6a5e]"></span>
      <span class="h-3 w-3 rounded-full bg-[#f4bf4f]"></span>
      <span class="h-3 w-3 rounded-full bg-[#61c454]"></span>
    </div>
    <div
      class="mx-auto flex items-center gap-1.5 rounded-md border border-border bg-card px-3 py-1 text-xs text-muted"
    >
      <svg class="h-3 w-3 text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="11" width="18" height="10" rx="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      localhost:8080
    </div>
  </div>

  <!-- App body -->
  <div class="bg-surface p-4 sm:p-5">
    <!-- Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2 font-semibold text-ink">
        <span aria-hidden="true">📡</span>
        <span class="text-sm">Internet Monitor</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="flex rounded-lg border border-border bg-card p-0.5 text-xs">
          {
            ranges.map((r) => (
              <span
                class={`rounded-md px-2.5 py-1 font-medium ${r === '7d' ? 'bg-accent text-white' : 'text-muted'}`}
              >
                {r}
              </span>
            ))
          }
        </div>
        <span
          class="hidden rounded-lg bg-accent px-3 py-1.5 text-xs font-semibold text-white sm:inline"
        >
          Run test
        </span>
      </div>
    </div>

    <!-- Stat cards -->
    <div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="rounded-lg border border-border bg-card p-3">
            <div class="text-xs text-muted">{s.label}</div>
            <div class="mt-1 flex items-baseline gap-1">
              <span
                class="tabular text-2xl font-bold"
                style={`color: var(--${s.accent === 'ink' ? 'ink' : s.accent})`}
              >
                {s.value}
              </span>
              <span class="text-xs text-faint">{s.unit}</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Chart card -->
    <div class="mt-3 rounded-lg border border-border bg-card p-4">
      <div class="mb-3 flex items-center justify-between">
        <span class="text-xs font-medium text-muted">Throughput · last 7 days</span>
        <div class="flex items-center gap-3 text-xs text-muted">
          <span class="flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full" style="background: var(--series-1)"></span>
            Download
          </span>
          <span class="flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full" style="background: var(--series-2)"></span>
            Upload
          </span>
        </div>
      </div>

      <svg viewBox="0 0 640 200" class="h-40 w-full sm:h-48" preserveAspectRatio="none" role="img" aria-label="Throughput chart showing download and upload over time">
        <defs>
          <linearGradient id="fillDownload" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--series-1)" stop-opacity="0.28"></stop>
            <stop offset="100%" stop-color="var(--series-1)" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient id="fillUpload" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--series-2)" stop-opacity="0.22"></stop>
            <stop offset="100%" stop-color="var(--series-2)" stop-opacity="0"></stop>
          </linearGradient>
        </defs>

        <!-- grid -->
        <g stroke="var(--chart-grid)" stroke-width="1">
          <line x1="0" y1="40" x2="640" y2="40"></line>
          <line x1="0" y1="90" x2="640" y2="90"></line>
          <line x1="0" y1="140" x2="640" y2="140"></line>
          <line x1="0" y1="190" x2="640" y2="190"></line>
        </g>

        <!-- download area + line -->
        <path
          d="M0 70 L64 58 L128 66 L192 44 L256 52 L320 38 L384 60 L448 46 L512 40 L576 54 L640 42 L640 190 L0 190 Z"
          fill="url(#fillDownload)"></path>
        <path
          d="M0 70 L64 58 L128 66 L192 44 L256 52 L320 38 L384 60 L448 46 L512 40 L576 54 L640 42"
          fill="none" stroke="var(--series-1)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>

        <!-- upload area + line -->
        <path
          d="M0 152 L64 148 L128 156 L192 146 L256 150 L320 142 L384 154 L448 148 L512 144 L576 150 L640 146 L640 190 L0 190 Z"
          fill="url(#fillUpload)"></path>
        <path
          d="M0 152 L64 148 L128 156 L192 146 L256 150 L320 142 L384 154 L448 148 L512 144 L576 150 L640 146"
          fill="none" stroke="var(--series-2)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>
  </div>
</div>
