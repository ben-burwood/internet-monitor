---
// An interactive recreation of the Internet Monitor dashboard, rendered from the
// app's design tokens. Tabs (Overview / Results / IP history), clickable time-range
// chips that swap the chart + stats, and a scrollable results table — all driven by
// the small client script at the bottom. Data is illustrative.

// ---- Chart geometry ------------------------------------------------------
const W = 640;
const BOTTOM = 195;
const TOP = 10;
const MAXV = 560; // Mbps at the top of the plot area

const yOf = (v: number) => +(BOTTOM - (Math.min(v, MAXV) / MAXV) * (BOTTOM - TOP)).toFixed(1);
const xOf = (i: number, n: number) => +((i * W) / (n - 1)).toFixed(1);
const line = (vals: number[]) =>
  vals.map((v, i) => `${i === 0 ? 'M' : 'L'}${xOf(i, vals.length)} ${yOf(v)}`).join(' ');
const area = (vals: number[]) => `${line(vals)} L${W} ${BOTTOM} L0 ${BOTTOM} Z`;

// ---- Per-range datasets --------------------------------------------------
const RAW = {
  '24h': {
    label: 'last 24 hours',
    stats: { download: '486.2', upload: '41.7', ping: '8.4', jitter: '1.2' },
    dl: [470, 478, 472, 485, 480, 492, 476, 488, 495, 483, 498, 486],
    ul: [41, 42, 40, 43, 41, 44, 40, 42, 45, 41, 43, 42],
  },
  '7d': {
    label: 'last 7 days',
    stats: { download: '472.5', upload: '42.9', ping: '9.1', jitter: '1.4' },
    dl: [452, 468, 461, 490, 447, 505, 470, 486, 462, 498, 455, 480],
    ul: [43, 40, 45, 41, 46, 39, 44, 42, 47, 40, 43, 42],
  },
  '30d': {
    label: 'last 30 days',
    stats: { download: '468.0', upload: '41.2', ping: '9.6', jitter: '1.6' },
    dl: [430, 470, 445, 500, 420, 490, 460, 510, 440, 495, 465, 468],
    ul: [38, 44, 41, 47, 36, 45, 42, 48, 39, 46, 40, 41],
  },
  all: {
    label: 'all time',
    stats: { download: '455.3', upload: '40.1', ping: '10.2', jitter: '1.8' },
    dl: [400, 480, 435, 520, 410, 500, 450, 515, 425, 505, 445, 455],
    ul: [35, 46, 40, 49, 34, 47, 41, 50, 37, 48, 39, 40],
  },
} as const;

type RangeKey = keyof typeof RAW;
const RANGES = Object.fromEntries(
  (Object.keys(RAW) as RangeKey[]).map((k) => {
    const r = RAW[k];
    return [
      k,
      {
        label: r.label,
        stats: r.stats,
        dlLine: line([...r.dl]),
        dlArea: area([...r.dl]),
        ulLine: line([...r.ul]),
        ulArea: area([...r.ul]),
      },
    ];
  })
);

const DEFAULT: RangeKey = '7d';
const d0 = RANGES[DEFAULT];

const rangeChips: { key: RangeKey; label: string }[] = [
  { key: '24h', label: '24h' },
  { key: '7d', label: '7d' },
  { key: '30d', label: '30d' },
  { key: 'all', label: 'All' },
];

// ---- Results history (illustrative) --------------------------------------
const rows = [
  { t: 'Sep 6, 14:02', dl: '486.2', ul: '41.7', ping: '8.4', jit: '1.2', loss: '0.0', srv: 'London', fail: false },
  { t: 'Sep 6, 13:02', dl: '498.1', ul: '43.0', ping: '8.1', jit: '1.0', loss: '0.0', srv: 'London', fail: false },
  { t: 'Sep 6, 12:02', dl: '471.6', ul: '40.9', ping: '9.0', jit: '1.5', loss: '0.0', srv: 'London', fail: false },
  { t: 'Sep 6, 11:02', dl: '—', ul: '—', ping: '—', jit: '—', loss: '—', srv: '', fail: true },
  { t: 'Sep 6, 10:02', dl: '483.4', ul: '42.2', ping: '8.7', jit: '1.3', loss: '0.0', srv: 'Slough', fail: false },
  { t: 'Sep 6, 09:02', dl: '495.0', ul: '44.1', ping: '7.9', jit: '0.9', loss: '0.0', srv: 'London', fail: false },
  { t: 'Sep 6, 08:02', dl: '476.8', ul: '41.0', ping: '9.2', jit: '1.6', loss: '0.1', srv: 'London', fail: false },
  { t: 'Sep 6, 07:02', dl: '488.9', ul: '42.7', ping: '8.5', jit: '1.1', loss: '0.0', srv: 'Slough', fail: false },
  { t: 'Sep 6, 06:02', dl: '461.3', ul: '39.8', ping: '9.8', jit: '1.8', loss: '0.0', srv: 'London', fail: false },
  { t: 'Sep 6, 05:02', dl: '505.2', ul: '45.3', ping: '7.6', jit: '0.8', loss: '0.0', srv: 'London', fail: false },
  { t: 'Sep 6, 04:02', dl: '479.5', ul: '41.4', ping: '8.9', jit: '1.4', loss: '0.0', srv: 'Slough', fail: false },
  { t: 'Sep 6, 03:02', dl: '492.7', ul: '43.6', ping: '8.2', jit: '1.0', loss: '0.0', srv: 'London', fail: false },
  { t: 'Sep 6, 02:02', dl: '468.0', ul: '40.2', ping: '9.5', jit: '1.7', loss: '0.0', srv: 'London', fail: false },
  { t: 'Sep 6, 01:02', dl: '486.1', ul: '42.0', ping: '8.6', jit: '1.2', loss: '0.0', srv: 'Slough', fail: false },
];

// ---- Public IP history (illustrative) ------------------------------------
const ipSegments = [
  { ip: '82.14.203.51', isp: 'Community Fibre', range: 'Aug 28 – now', count: 214, current: true },
  { ip: '82.14.199.8', isp: 'Community Fibre', range: 'Aug 12 – Aug 28', count: 388, current: false },
  { ip: '81.2.69.144', isp: 'Community Fibre', range: 'Jul 30 – Aug 12', count: 301, current: false },
];

const chipBase =
  'rounded-md px-2.5 py-1 text-xs font-medium transition';
---

<div
  id="mock"
  class="mx-auto max-w-4xl overflow-hidden rounded-xl border border-border bg-card shadow-2xl shadow-black/10 ring-1 ring-black/5"
>
  <!-- Window chrome -->
  <div class="flex items-center gap-2 border-b border-border bg-surface-2 px-4 py-3">
    <div class="flex gap-1.5">
      <span class="h-3 w-3 rounded-full bg-[#ec6a5e]"></span>
      <span class="h-3 w-3 rounded-full bg-[#f4bf4f]"></span>
      <span class="h-3 w-3 rounded-full bg-[#61c454]"></span>
    </div>
    <div
      class="mx-auto flex items-center gap-1.5 rounded-md border border-border bg-card px-3 py-1 text-xs text-muted"
    >
      <svg class="h-3 w-3 text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="11" width="18" height="10" rx="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      localhost:8080
    </div>
  </div>

  <!-- App body -->
  <div class="bg-surface p-4 sm:p-5">
    <!-- Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2 font-semibold text-ink">
        <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2a10 10 0 1 0 10 10"></path>
          <path d="M12 12 16 8"></path>
          <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"></circle>
        </svg>
        <span class="text-sm">Internet Monitor</span>
      </div>
      <button
        type="button"
        id="mock-run"
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-accent-strong"
      >
        <svg id="mock-run-icon" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z"></path>
        </svg>
        <span id="mock-run-label">Run test</span>
      </button>
    </div>

    <!-- Tab bar -->
    <div class="mt-4 flex rounded-lg border border-border bg-card p-0.5 text-xs">
      <button type="button" data-tab="overview" class={`mock-tab flex-1 ${chipBase} bg-accent text-white`}>Overview</button>
      <button type="button" data-tab="results" class={`mock-tab flex-1 ${chipBase} text-muted`}>Results</button>
      <button type="button" data-tab="ips" class={`mock-tab flex-1 ${chipBase} text-muted`}>IP history</button>
    </div>

    <!-- Panels -->
    <div class="mt-3 min-h-[19rem]">
      <!-- Overview -->
      <div data-panel="overview">
        <!-- Stat cards -->
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          <div class="rounded-lg border border-border bg-card p-3">
            <div class="text-xs text-muted">Download</div>
            <div class="mt-1 flex items-baseline gap-1">
              <span id="stat-download" class="tabular text-2xl font-bold" style="color: var(--series-1)">{d0.stats.download}</span>
              <span class="text-xs text-faint">Mbps</span>
            </div>
          </div>
          <div class="rounded-lg border border-border bg-card p-3">
            <div class="text-xs text-muted">Upload</div>
            <div class="mt-1 flex items-baseline gap-1">
              <span id="stat-upload" class="tabular text-2xl font-bold" style="color: var(--series-2)">{d0.stats.upload}</span>
              <span class="text-xs text-faint">Mbps</span>
            </div>
          </div>
          <div class="rounded-lg border border-border bg-card p-3">
            <div class="text-xs text-muted">Ping</div>
            <div class="mt-1 flex items-baseline gap-1">
              <span id="stat-ping" class="tabular text-2xl font-bold text-ink">{d0.stats.ping}</span>
              <span class="text-xs text-faint">ms</span>
            </div>
          </div>
          <div class="rounded-lg border border-border bg-card p-3">
            <div class="text-xs text-muted">Jitter</div>
            <div class="mt-1 flex items-baseline gap-1">
              <span id="stat-jitter" class="tabular text-2xl font-bold text-ink">{d0.stats.jitter}</span>
              <span class="text-xs text-faint">ms</span>
            </div>
          </div>
        </div>

        <!-- Chart card -->
        <div class="mt-3 rounded-lg border border-border bg-card p-4">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <span id="chart-title" class="text-xs font-medium text-muted">Throughput · {d0.label}</span>
            <div class="flex items-center gap-3">
              <div class="flex items-center gap-3 text-xs text-muted">
                <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full" style="background: var(--series-1)"></span>Download</span>
                <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full" style="background: var(--series-2)"></span>Upload</span>
              </div>
              <div class="flex rounded-md border border-border bg-surface-2 p-0.5 text-xs">
                {
                  rangeChips.map((c) => (
                    <button
                      type="button"
                      data-range={c.key}
                      class={`mock-range ${chipBase} ${c.key === DEFAULT ? 'bg-accent text-white' : 'text-muted'}`}
                    >
                      {c.label}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>

          <svg viewBox="0 0 640 200" class="h-40 w-full sm:h-44" preserveAspectRatio="none" role="img" aria-label="Throughput chart">
            <defs>
              <linearGradient id="fillDownload" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--series-1)" stop-opacity="0.28"></stop>
                <stop offset="100%" stop-color="var(--series-1)" stop-opacity="0"></stop>
              </linearGradient>
              <linearGradient id="fillUpload" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--series-2)" stop-opacity="0.22"></stop>
                <stop offset="100%" stop-color="var(--series-2)" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <g stroke="var(--chart-grid)" stroke-width="1">
              <line x1="0" y1="40" x2="640" y2="40"></line>
              <line x1="0" y1="90" x2="640" y2="90"></line>
              <line x1="0" y1="140" x2="640" y2="140"></line>
              <line x1="0" y1="190" x2="640" y2="190"></line>
            </g>
            <path id="dl-area" d={d0.dlArea} fill="url(#fillDownload)" class="transition-all duration-500"></path>
            <path id="dl-line" d={d0.dlLine} fill="none" stroke="var(--series-1)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-all duration-500"></path>
            <path id="ul-area" d={d0.ulArea} fill="url(#fillUpload)" class="transition-all duration-500"></path>
            <path id="ul-line" d={d0.ulLine} fill="none" stroke="var(--series-2)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-all duration-500"></path>
          </svg>
        </div>
      </div>

      <!-- Results -->
      <div data-panel="results" class="hidden">
        <div class="rounded-lg border border-border bg-card">
          <div class="flex items-center justify-between border-b border-border px-4 py-2.5">
            <span class="text-xs font-semibold text-ink">Results</span>
            <span class="text-xs text-muted">{rows.length} tests · {rows.filter((r) => !r.fail).length} succeeded</span>
          </div>
          <div class="max-h-64 overflow-auto">
            <table class="w-full min-w-[640px] border-collapse text-left text-sm tabular">
              <thead>
                <tr class="sticky top-0 bg-card text-xs uppercase tracking-wide text-faint">
                  <th class="px-3 py-2 font-medium">Time</th>
                  <th class="px-3 py-2 text-right font-medium">Down</th>
                  <th class="px-3 py-2 text-right font-medium">Up</th>
                  <th class="px-3 py-2 text-right font-medium">Ping</th>
                  <th class="px-3 py-2 text-right font-medium">Jitter</th>
                  <th class="px-3 py-2 text-right font-medium">Loss</th>
                  <th class="px-3 py-2 font-medium">Server</th>
                </tr>
              </thead>
              <tbody>
                {
                  rows.map((r) => (
                    <tr class={`border-t border-border/70 ${r.fail ? 'text-danger' : ''}`}>
                      <td class="whitespace-nowrap px-3 py-2">{r.t}</td>
                      {r.fail ? (
                        <td colspan="6" class="px-3 py-2">Failed: speedtest CLI timeout</td>
                      ) : (
                        <>
                          <td class="px-3 py-2 text-right">{r.dl}</td>
                          <td class="px-3 py-2 text-right">{r.ul}</td>
                          <td class="px-3 py-2 text-right">{r.ping}</td>
                          <td class="px-3 py-2 text-right">{r.jit}</td>
                          <td class="px-3 py-2 text-right">{r.loss}</td>
                          <td class="whitespace-nowrap px-3 py-2 text-muted">{r.srv}</td>
                        </>
                      )}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- IP history -->
      <div data-panel="ips" class="hidden">
        <div class="rounded-lg border border-border bg-card">
          <div class="flex items-center justify-between border-b border-border px-4 py-2.5">
            <span class="text-xs font-semibold text-ink">Public IP history</span>
            <span class="text-xs text-muted">{ipSegments.length - 1} changes</span>
          </div>
          <div class="max-h-64 overflow-auto px-4 py-3">
            <ol class="flex flex-col">
              {
                ipSegments.map((seg, i) => (
                  <li class="relative flex gap-3 pb-4 last:pb-0">
                    {i !== ipSegments.length - 1 && (
                      <span class="absolute left-[3.5px] top-3 h-full w-px bg-border" aria-hidden="true"></span>
                    )}
                    <span class={`relative mt-1.5 h-2 w-2 shrink-0 rounded-full ${i === 0 ? 'bg-accent' : 'bg-muted'}`}></span>
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="tabular font-semibold text-ink">{seg.ip}</span>
                        {seg.current && (
                          <span class="rounded bg-accent/15 px-1.5 py-0.5 text-xs font-medium text-accent">current</span>
                        )}
                        <span class="text-xs text-muted">{seg.isp}</span>
                      </div>
                      <div class="mt-0.5 text-xs text-muted">{seg.range} · {seg.count} tests</div>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script
    type="application/json"
    id="mock-data"
    set:html={JSON.stringify(RANGES)}
  />
</div>

<script>
  const root = document.getElementById('mock');
  if (root) {
    const dataEl = document.getElementById('mock-data');
    const data: Record<string, any> = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};

    const setActive = (btns: NodeListOf<Element>, active: Element) => {
      btns.forEach((b) => {
        const on = b === active;
        b.classList.toggle('bg-accent', on);
        b.classList.toggle('text-white', on);
        b.classList.toggle('text-muted', !on);
      });
    };

    // Tabs
    const tabs = root.querySelectorAll('.mock-tab');
    tabs.forEach((btn) =>
      btn.addEventListener('click', () => {
        const target = (btn as HTMLElement).dataset.tab;
        setActive(tabs, btn);
        root.querySelectorAll('[data-panel]').forEach((p) =>
          p.classList.toggle('hidden', (p as HTMLElement).dataset.panel !== target)
        );
      })
    );

    // Time-range chips
    const ranges = root.querySelectorAll('.mock-range');
    const set = (id: string, attr: string, val: string) => {
      const el = root.querySelector(id);
      if (el) el.setAttribute(attr, val);
    };
    const text = (id: string, val: string) => {
      const el = root.querySelector(id);
      if (el) el.textContent = val;
    };
    ranges.forEach((btn) =>
      btn.addEventListener('click', () => {
        const key = (btn as HTMLElement).dataset.range!;
        const d = data[key];
        if (!d) return;
        setActive(ranges, btn);
        set('#dl-area', 'd', d.dlArea);
        set('#dl-line', 'd', d.dlLine);
        set('#ul-area', 'd', d.ulArea);
        set('#ul-line', 'd', d.ulLine);
        text('#chart-title', `Throughput · ${d.label}`);
        text('#stat-download', d.stats.download);
        text('#stat-upload', d.stats.upload);
        text('#stat-ping', d.stats.ping);
        text('#stat-jitter', d.stats.jitter);
      })
    );

    // "Run test" — brief spinner for a real feel
    const run = root.querySelector('#mock-run') as HTMLButtonElement | null;
    const runLabel = root.querySelector('#mock-run-label');
    const runIcon = root.querySelector('#mock-run-icon');
    if (run && runLabel && runIcon) {
      run.addEventListener('click', () => {
        if (run.disabled) return;
        run.disabled = true;
        run.classList.add('opacity-70');
        runIcon.classList.add('animate-spin');
        runIcon.innerHTML = '<path d="M12 2a10 10 0 1 0 10 10" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />';
        runLabel.textContent = 'Testing…';
        setTimeout(() => {
          run.disabled = false;
          run.classList.remove('opacity-70');
          runIcon.classList.remove('animate-spin');
          runIcon.innerHTML = '<path d="M8 5v14l11-7z" />';
          runLabel.textContent = 'Run test';
        }, 1800);
      });
    }
  }
</script>
