---
import { REPO_URL, RELEASES_URL, LICENSE_URL, INSPIRATION } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-t border-border/70 bg-surface-2">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 py-10 sm:flex-row">
    <div class="flex flex-col items-center gap-1.5 sm:items-start">
      <div class="flex items-center gap-2.5">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5 text-accent"
          aria-hidden="true"
        >
          <path d="M12 2a10 10 0 1 0 10 10"></path>
          <path d="M12 12 16 8"></path>
          <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"></circle>
        </svg>
        <span class="text-sm font-semibold">Internet Monitor</span>
        <span class="hidden text-sm text-faint sm:inline">· Self-hosted speedtest dashboard</span>
      </div>
      <p class="text-xs text-faint">
        Inspired by {
          INSPIRATION.map((p, i) => (
            <>
              <a href={p.url} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-muted">
                {p.name}
              </a>
              {i < INSPIRATION.length - 1 ? ' and ' : ''}
            </>
          ))
        }
      </p>
    </div>

    <div class="flex items-center gap-5 text-sm text-muted">
      <a href={REPO_URL} target="_blank" rel="noopener" class="transition hover:text-ink">GitHub</a>
      <a href={RELEASES_URL} target="_blank" rel="noopener" class="transition hover:text-ink">Releases</a>
      <a href={LICENSE_URL} target="_blank" rel="noopener" class="transition hover:text-ink">MIT License</a>
    </div>
  </div>

  <div class="border-t border-border/60">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-5 py-4 text-xs text-faint sm:flex-row">
      <span>© {year} Ben Burwood · Released under the MIT License</span>
      <span>Built with Go + Vue</span>
    </div>
  </div>
</footer>
