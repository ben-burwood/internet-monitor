---
import { Icon } from 'astro-icon/components';
import { DOCKER_IMAGE, GHCR_PACKAGE_URL, REPO_URL } from '../consts';

const compose = `services:
  internet-monitor:
    image: ${DOCKER_IMAGE}
    container_name: internet-monitor
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      - ./store:/store
    environment:
      SPEEDTEST_INTERVAL: "1h"   # Go duration: 30m, 1h, 6h…
      DATA_RETENTION: ""          # Go duration. Empty = keep forever.`;

const runCmd = 'docker compose up -d';

const config = [
  {
    name: 'SPEEDTEST_INTERVAL',
    def: '1h',
    desc: 'Time between tests (Go duration, e.g. 30m, 6h).',
  },
  {
    name: 'DATA_RETENTION',
    def: '(unset)',
    desc: 'Prune results older than this. Unset = keep forever.',
  },
];
---

<section id="install" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Install Internet Monitor</h2>
    </div>

    <div class="mx-auto mt-10 grid max-w-4xl gap-5 lg:grid-cols-5">
      <!-- compose.yml -->
      <div class="min-w-0 lg:col-span-3">
        <div class="overflow-hidden rounded-xl border border-border bg-card">
          <div class="flex items-center justify-between border-b border-border bg-surface-2 px-4 py-2.5">
            <span class="flex items-center gap-2 text-xs font-medium text-muted">
              <Icon name="heroicons:document-text" width="14" height="14" aria-hidden="true" />
              compose.yml
            </span>
            <button
              type="button"
              class="copy-btn inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-muted transition hover:bg-card hover:text-ink"
              data-copy={compose}
            >
              <Icon name="heroicons:clipboard-document" width="14" height="14" aria-hidden="true" />
              <span class="copy-label">Copy</span>
            </button>
          </div>
          <pre class="overflow-x-auto p-4 text-sm leading-relaxed"><code class="tabular">{compose}</code></pre>
        </div>
      </div>

      <!-- run + note -->
      <div class="flex min-w-0 flex-col gap-5 lg:col-span-2">
        <div class="overflow-hidden rounded-xl border border-border bg-card">
          <div class="flex items-center justify-between border-b border-border bg-surface-2 px-4 py-2.5">
            <span class="flex items-center gap-2 text-xs font-medium text-muted">
              <Icon name="heroicons:command-line" width="14" height="14" aria-hidden="true" />
              start it
            </span>
            <button
              type="button"
              class="copy-btn inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-muted transition hover:bg-card hover:text-ink"
              data-copy={runCmd}
            >
              <Icon name="heroicons:clipboard-document" width="14" height="14" aria-hidden="true" />
              <span class="copy-label">Copy</span>
            </button>
          </div>
          <pre class="overflow-x-auto p-4 text-sm"><code>$ {runCmd}</code></pre>
        </div>

        <div class="rounded-xl border border-accent/25 bg-accent/10 p-4 text-sm text-ink">
          <p class="flex items-start gap-2">
            <Icon name="heroicons:arrow-top-right-on-square" width="16" height="16" class="mt-0.5 shrink-0 text-accent" aria-hidden="true" />
            <span>
              Open <a href="http://localhost:8080" class="font-medium text-accent underline underline-offset-2">localhost:8080</a>.
              The SQLite database is persisted to <code class="rounded bg-surface-2 px-1 py-0.5 text-xs">./store</code>.
              The first test runs a minute after startup, then on your interval.
            </span>
          </p>
        </div>
      </div>
    </div>

    <!-- config table -->
    <div class="mx-auto mt-6 max-w-4xl overflow-hidden rounded-xl border border-border bg-card">
      <div class="border-b border-border bg-surface-2 px-4 py-2.5 text-xs font-medium text-muted">
        Configuration — all environment variables are optional
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="text-xs uppercase tracking-wide text-faint">
            <tr class="border-b border-border">
              <th class="px-4 py-2.5 font-medium">Variable</th>
              <th class="px-4 py-2.5 font-medium">Default</th>
              <th class="px-4 py-2.5 font-medium">Description</th>
            </tr>
          </thead>
          <tbody>
            {
              config.map((c) => (
                <tr class="border-b border-border/60 last:border-0">
                  <td class="whitespace-nowrap px-4 py-3 font-mono text-xs text-accent">{c.name}</td>
                  <td class="whitespace-nowrap px-4 py-3 font-mono text-xs text-muted">{c.def}</td>
                  <td class="px-4 py-3 text-muted">{c.desc}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      const label = btn.querySelector('.copy-label');
      try {
        await navigator.clipboard.writeText(text);
        if (label) {
          const prev = label.textContent;
          label.textContent = 'Copied!';
          setTimeout(() => {
            label.textContent = prev;
          }, 1500);
        }
      } catch {
        /* clipboard unavailable — no-op */
      }
    });
  });
</script>
